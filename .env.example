# OpenShomer Environment Variables
OPENSHOMER_ENV=development
API_PORT=8000
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Providers (Alibaba Cloud Model Studio / Qwen, Anthropic, Gemini, OpenAI, etc.)
DASHSCOPE_API_KEY=your_alibaba_cloud_dashscope_api_key_here
ALIBABA_CLOUD_API_KEY=your_alibaba_cloud_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

